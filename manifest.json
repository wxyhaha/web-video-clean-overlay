{
  "manifest_version": 3,
  "name": "优酷暂停广告清除器 (Kill Youku Pause Ad)",
  "version": "1.1.0",
  "description": "专为优酷 VIP 打造的轻量插件，清除暂停广告与黑屏，支持鼠标前进/后退键自定义秒数快进快退。",
  "permissions": [
    "storage",
    "tabs"
  ],
  "host_permissions": [
    "*://*.youku.com/*"
  ],
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    },
    "default_title": "优酷暂停广告清除器"
  },
  "background": {
    "service_worker": "background/service-worker.js"
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.youku.com/*"
      ],
      "all_frames": true,
      "match_about_blank": true,
      "css": [
        "content/content.css"
      ],
      "js": [
        "content/content.js"
      ],
      "run_at": "document_start"
    }
  ]
}
